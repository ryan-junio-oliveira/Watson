# Watson — .env.example (template)
# Copie para .env:  copy .env.example .env  (Windows)  |  cp .env.example .env (Linux)
# Edite via arquivo ou via web em http://localhost:9000/config
# Após alterar, reinicie a API: docker compose restart ou reinicie o processo

# ============================================================
# ESSENCIAL — 20 vars que 90% dos usuários precisam
# ============================================================

# Watson — Perfil (igual Gemini/ChatGPT: Flash < Pro)
WATSON_PROFILE=flash
# flash = mais rápido (default), pro = mais inteligente (analisar default, lento) — plus removido, mapeado para flash

# Ollama — LLM principal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# OLLAMA_MODEL opções: gemma3:4b (leve/CPU), qwen3:8b (reasoning), deepseek-r1:7b (CoT), gemma3:12b (GPU)

# Geração
TEMPERATURE=0.1
MAX_TOKENS=2048
AGENT_NAME=Watson

# Embeddings — busca vetorial PT-BR
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# RAG — retrieval
TOP_K=5
CHUNK_SIZE=1000

# Query Understanding — LLM intermediário que enriquece "erro hp e52645" → 5 queries
ENABLE_QUERY_REWRITER=true

# Web Search — modo web isolado (toggle "web" no chat)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5
# DuckDuckGo = default free sem key
# SearXNG opcional: WEB_SEARCH_PROVIDER=searxng + SEARXNG_URL=http://localhost:8080 (docker run -p 8080:8080 searxng/searxng)
# Google opcional: WEB_SEARCH_PROVIDER=google + GOOGLE_API_KEY + GOOGLE_CX

# API Server
API_HOST=0.0.0.0
API_PORT=9000
API_AUTH_TOKEN=
# Preencha para exigir X-API-Token:  API_AUTH_TOKEN=um-texto-longo

# Observabilidade
LOG_LEVEL=INFO

# ============================================================
# AVANÇADO — só mexa se souber (38 vars, defaults em core/config.py)
# Descomente a linha para sobrescrever o default
# ============================================================

# --- Ollama timeout ---
# OLLAMA_TIMEOUT=300

# --- Embeddings avançado ---
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_NORMALIZE=true
# EMBEDDING_CACHE_PATH=database/embedding_cache.sqlite3

# --- Documentos ---
# DOCUMENTS_DIR=documents
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_DEST_DIR=documents/drive
# GOOGLE_DRIVE_SYNC_TIMEOUT=60
# GOOGLE_DRIVE_WORKERS=8

# --- OCR / Imagens ---
# TESSERACT_CMD=
# OCR_LANG=por+eng
# OCR_DPI=200
# OCR_MIN_TEXT_CHARS=20
# IMAGE_DIR=database/images
# VISION_MODEL=moondream
# DEDUP_CROSS_DOC=true
# DEDUP_PERSIST_PATH=database/dedup.json

# --- Quality gate (descarta chunks ruins) ---
# QUALITY_MIN_CHARS=20
# QUALITY_MIN_CHARS_TABLE=10
# QUALITY_MIN_CHARS_IMAGE=30
# QUALITY_TABLE_MIN_PIPES=4
# QUALITY_OCR_THRESHOLD=0.6

# --- Chunking / Vector DB ---
# CHUNK_OVERLAP=200
# INDEX_BATCH_SIZE=100
# VECTOR_DB_DIR=database/chroma

# --- Retrieval fino ---
# SIMILARITY_THRESHOLD=0.0
# USE_MMR=false
# MMR_FETCH_K=20
# MMR_LAMBDA=0.5
# USE_RERANKER=false
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Reasoning / Analyst ---
# ENABLE_REASONING=false
# ENABLE_ANALYST=true
# ANALYST_MAX_FOLLOWUPS=3
# ANALYST_MODEL=
# ANALYST_TEMPERATURE=0.2
# ANALYST_MAX_TOKENS=4096
# ANALYST_THINK=true
# REASONING_TOP_K=12
# REASONING_TEMPERATURE=0.2
# REASONING_MAX_TOKENS=3072
# ENABLE_QUERY_EXPANSION=true
# QUERY_EXPANSION_VARIANTS=3
# ENABLE_RERANKER_REASONING=true
# QUERY_REWRITER_MODEL=
# QUERY_REWRITER_MAX_EXPANDED=5

# --- API fino ---
# API_RATE_ENABLED=true
# API_RATE_LIMIT=30
# API_RATE_WINDOW=60
# LOG_FILE=logs/ai_agent.log
# METRICS_DB=database/metrics.db

# --- Web Search fino ---
# SEARXNG_URL=http://localhost:8080
# GOOGLE_API_KEY=
# GOOGLE_CX=
# SERPER_API_KEY=
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT=15
# TAVILY_SEARCH_DEPTH=basic
# WEB_SEARCH_TRUSTED_DOMAINS=g1.globo.com,uol.com.br,folha.uol.com.br,estadao.com.br,terra.com.br,veja.abril.com.br,cnnbrasil.com,cnn.com,bbc.com,band.uol.com.br,jovempan.com.br,sbt.com.br,record.r7.com,correiobraziliense.com.br,metropoles.com,gazetadopovo.com.br,exame.com,infomoney.com.br
