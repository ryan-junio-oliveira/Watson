# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180

# Modelo LLM
TEMPERATURE=0.1
MAX_TOKENS=2048

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_PATH=database/embedding_cache.sqlite3

# Documentos
# DOCUMENTS_DIR=documents

# Google Drive (pasta pública — sem OAuth)
# GOOGLE_DRIVE_FOLDER_ID=<folder_id_da_pasta_publica>
# GOOGLE_DRIVE_DEST_DIR=documents/drive
# GOOGLE_DRIVE_SYNC_TIMEOUT=60

# OCR (Tesseract) — diretório que contém o tesseract.exe (não o caminho do .exe)
TESSERACT_CMD=libs/tesseract
OCR_LANG=por+eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=20

# Imagens
IMAGE_DIR=database/images
# Modelo de visão Ollama p/ descrição estruturada de imagens técnicas (ex.: llava, qwen2.5vl)
# VISION_MODEL=

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INDEX_BATCH_SIZE=100

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.0
USE_MMR=false
MMR_FETCH_K=20
MMR_LAMBDA=0.5

# Reranker (cross-encoder)
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha
DB_NAME=dokviewermanager
# DB_CONNECTION_STRING tambem e aceito (raw URL), mas as variaveis acima sao recomendadas
# pois o password e URL-encoded automaticamente
# DB_TABLES=["licenses","clients","installations","license_renewal_history"]
# DB_MODE=both | sql | rag  (sql = consulta direta via SQL Tool, sem embeddings)
DB_MODE=both
DB_MAX_ROWS_PER_QUERY=200

# Web Search
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5

# Planner / Classifier
ENABLE_PLANNER=true

# Fact Validator
ENABLE_VALIDATOR=true
MIN_CONFIDENCE=0.5

# API Server
API_HOST=0.0.0.0
API_PORT=9000
# Token exigido no header X-API-Token. Deixe vazio para desativar a auth (apenas dev local).
API_AUTH_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai_agent.log
