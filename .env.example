# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=300

# Modelo LLM
TEMPERATURE=0.1
MAX_TOKENS=2048

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_PATH=database/embedding_cache.sqlite3

# Documentos
# DOCUMENTS_DIR=documents

# Google Drive (pasta pública — sem OAuth)
# GOOGLE_DRIVE_FOLDER_ID=<folder_id_da_pasta_publica>
# GOOGLE_DRIVE_DEST_DIR=documents/drive
# GOOGLE_DRIVE_SYNC_TIMEOUT=60
# Downloads paralelos durante o sync (mínimo 1)
# GOOGLE_DRIVE_WORKERS=8

# OCR (Tesseract) — vazio = usa binario do PATH (Linux) ou libs/tesseract (Windows)
TESSERACT_CMD=
OCR_LANG=por+eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=20

# Imagens
IMAGE_DIR=database/images
# Modelo de visão Ollama p/ descrição estruturada de imagens técnicas (moondream: leve 1.8B rapido | qwen2.5vl: pesado 8B)
VISION_MODEL=moondream
# Deduplicação cross-doc persistida
DEDUP_CROSS_DOC=true
DEDUP_PERSIST_PATH=database/dedup.json
# Quality gate por tipo
QUALITY_MIN_CHARS=20
QUALITY_MIN_CHARS_TABLE=10
QUALITY_MIN_CHARS_IMAGE=30
QUALITY_TABLE_MIN_PIPES=4
QUALITY_OCR_THRESHOLD=0.6

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INDEX_BATCH_SIZE=100

# Banco vetorial (ChromaDB)
# VECTOR_DB_DIR=database/chroma

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.0
USE_MMR=false
MMR_FETCH_K=20
MMR_LAMBDA=0.5

# Reranker (cross-encoder)
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Watson Analista (persona + raciocínio + análise proativa)
ENABLE_REASONING=false
ENABLE_ANALYST=true
ANALYST_MAX_FOLLOWUPS=3
# Raciocínio avançado (CoT + multi-query RRF)
REASONING_TOP_K=12
REASONING_TEMPERATURE=0.2
REASONING_MAX_TOKENS=3072
ENABLE_QUERY_EXPANSION=true
QUERY_EXPANSION_VARIANTS=3
ENABLE_RERANKER_REASONING=true

# API Server
API_HOST=0.0.0.0
API_PORT=9000
# Token exigido no header X-API-Token. Deixe vazio para desativar a auth (apenas dev local).
API_AUTH_TOKEN=
# Rate limiting (proteção contra abuso em /api/chat)
API_RATE_LIMIT=30
API_RATE_WINDOW=60
API_RATE_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ai_agent.log

# Agente
AGENT_NAME=Watson

# Métricas (dashboard)
METRICS_DB=database/metrics.db
